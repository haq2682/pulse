# HUGGING FACE
HF_TOKEN="your_huggingface_token_here"

# POSTGRES DATABASE
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_postgres_password"
POSTGRES_DATABASE_NAME="your_database_name"
POSTGRES_SERVER="your_postgres_server"
SPARK_SERVER="your_spark_server"
GEMINI_API_KEY="your_gemini_api_key"
MINIO_ENDPOINT="your_minio_endpoint"  # e.g., "localhost:9000" or "http://localhost:9000" (protocol optional)
MINIO_ACCESS_KEY="your_minio_access_key"
MINIO_SECRET_KEY="your_minio_secret_key"
MINIO_ROOT_USER="your_minio_root_user"
MINIO_ROOT_PASSWORD="your_minio_root_password"
COMPOSE_PROJECT_NAME="your_project_name"
KAFKA_BOOTSTRAP="your_kafka_bootstrap_internal"
KAFKA_BOOTSTRAP_EXTERNAL="your_kafka_bootstrap_external"

# Streaming Database Configuration (for external data sources)
# These credentials should be provided by the database administrator
# after setting up the appropriate user and permissions as described
# in mapping/README.md
#
# Example formats:
# PostgreSQL: postgresql://debezium_user:password@hostname:5432/database
# MySQL: mysql://debezium_user:password@hostname:3306/database
# MongoDB: mongodb://debezium_user:password@hostname:27017/database?replicaSet=rs0
# SQL Server: mssql://debezium_user:password@hostname:1433/database
STREAMING_DB_URI="postgresql://debezium_user:password@external-host:5432/external_db"

# SECRET KEY - Used for signing tokens
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="replace_this_with_a_secure_random_hex_string"

# SESSION SETTINGS
SESSION_EXPIRE_MINUTES=1440      # 24 hours (60 * 24)
PASSWORD_RESET_EXPIRE_MINUTES=30 # Reset links valid for 30 mins

# REDIS CONNECTION
REDIS_HOST=10.5.0.11
REDIS_PORT=6379

# EMAIL SETTINGS (for password reset emails)
# For Gmail: Enable "App Passwords" in Google Account settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASSWORD="your_app_specific_password"
FROM_EMAIL="Pulse Analytics Engine <your_email@gmail.com>"

# GOOGLE OAUTH
# Get these from Google Cloud Console:
# 1. Go to console.cloud.google.com
# 2. Create a project
# 3. Enable Google+ API
# 4. Create OAuth 2.0 credentials
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:8000/auth/google/callback"

# FRONTEND URL (for email links)
FRONTEND_URL="http://localhost:5173"

# APPLICATION ENVIRONMENT
# Controls security features: cookie secure flag, API docs visibility, etc.
# Set to "production" when deploying behind HTTPS.
ENVIRONMENT="development"

# NiFi Admin Credentials
NIFI_ADMIN_USER="admin"
NIFI_ADMIN_PASSWORD="change_this_in_production"

# Debezium initial snapshot wait time (seconds)
# Increase for large databases; default is 90 seconds.
DEBEZIUM_SNAPSHOT_WAIT=90

#NGINX DEV
NGINX_MODE=development              # 'development' or 'production'
NGINX_DOMAIN=localhost              # Change to 'nifi.yourdomain.com' in production
NGINX_HTTP_PORT=8082                # HTTP port (dev) or HTTP→HTTPS redirect port (prod)
NGINX_HTTPS_PORT=9443               # HTTPS port (only used in production)

#NGINX PROD
NGINX_MODE=production
NGINX_DOMAIN=nifi.yourdomain.com
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

VITE_API_URL=http://localhost:8000
GEMINI_MODEL="gemini-2.0-flash-lite"
# ─── Apache Airflow ───────────────────────────────────────────────────────────
# Fernet key: generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY="46BKJoQYlPPOexq0OhDZnIlNepKFf87WFwLt0jJgrg="
AIRFLOW_SECRET_KEY="pulse_secret_key_change_me"
AIRFLOW_ADMIN_USER="admin"
AIRFLOW_ADMIN_PASSWORD="admin"

# Airflow uses the same PostgreSQL server but a separate database named 'airflow'.
# Create it before first launch:  CREATE DATABASE airflow;
# (The postgresql container is configured to accept connections from all containers.)

# Pipeline connection overrides (optional – defaults read from MINIO_*/KAFKA_* above)
FRONTEND_API_URL="http://10.5.0.9:8000/api/ingest/stream"
API_POLL_INTERVAL=30
API_POLL_DURATION=300

# KS-test thresholds (optional overrides)
KS_ALPHA=0.05
KS_DRIFT_RATIO=0.20
KS_MIN_SAMPLE=100
KS_BASELINE_SAMPLES=5000
AIRFLOW_FERNET_KEY=FERNET_KEY_HERE
