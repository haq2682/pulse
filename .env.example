# HUGGING FACE
HF_TOKEN="your_huggingface_token_here"

# POSTGRES DATABASE
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_postgres_password"
POSTGRES_DATABASE_NAME="pulse"
POSTGRES_SERVER="localhost"

# GOOGLE GEMINI AI
GEMINI_API_KEY="your_gemini_api_key_here"

# APACHE SPARK
SPARK_SERVER="spark://localhost:7077"

# MINIO (S3 COMPATIBLE STORAGE)
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin"

# DOCKER COMPOSE
COMPOSE_PROJECT_NAME="pulse"

# KAFKA
KAFKA_BOOTSTRAP="localhost:9092"
KAFKA_BOOTSTRAP_EXTERNAL="localhost:9092"

# SECRET KEY - Used for signing tokens
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="replace_this_with_a_secure_random_hex_string"

# SESSION SETTINGS
SESSION_EXPIRE_MINUTES=1440      # 24 hours (60 * 24)
PASSWORD_RESET_EXPIRE_MINUTES=30 # Reset links valid for 30 mins

# REDIS CONNECTION
REDIS_HOST=10.5.0.10
REDIS_PORT=6379

# EMAIL SETTINGS (for password reset emails)
# For Gmail: Enable "App Passwords" in Google Account settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASSWORD="your_app_specific_password"
FROM_EMAIL="Pulse Analytics Engine <your_email@gmail.com>"

# GOOGLE OAUTH
# Get these from Google Cloud Console:
# 1. Go to console.cloud.google.com
# 2. Create a project
# 3. Enable Google+ API
# 4. Create OAuth 2.0 credentials
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:8000/auth/google/callback"

# FRONTEND URL (for email links)
FRONTEND_URL="http://localhost:5173"