# =============================================================================
# Pulse nginx gateway
#   - Serves the built React SPA (same origin as the API -> no CORS needed)
#   - /api/*  -> FastAPI (service name: api), WebSocket upgrades included
#   - /health -> FastAPI health endpoint
#
# HTTP-only on purpose: TLS is terminated upstream (cloud LB / K8s ingress),
# which is where the certs live. This keeps the image cert-free and startable
# anywhere without mounting an ssl directory.
#
# Upstream hostname comes from ${API_UPSTREAM_HOST}, substituted into this
# file by the base nginx image's own envsubst-on-templates entrypoint step
# (this file lives in /etc/nginx/templates/, not /etc/nginx/conf.d/ - see
# the Dockerfile). Docker Compose's service name (api) and Kubernetes'
# Service name (pulse-api) are NOT the same string, so a single hardcoded
# hostname can't work in both - nginx resolves a literal (non-variable)
# proxy_pass target at config-load time, so the wrong one doesn't just
# misroute, it makes nginx fail to start at all ("host not found in
# upstream"). The Dockerfile ENV defaults this to Compose's name;
# deployment.yaml overrides it to the Kubernetes Service name for the
# pulse-nginx container.
#
# File uploads go through /api/onboarding/upload-chunk (plain FastAPI route,
# same proxy_pass as everything else under /api/) rather than a dedicated
# /upload location - NiFi (which previously owned this path, proxying to its
# own HandleHttpRequest listener on a separate upstream) has been removed
# from the stack. The large-body/long-timeout settings below are kept as
# server-wide defaults since /api/ still needs to accept big file uploads.
# =============================================================================

# Large file upload settings
client_max_body_size 10G;
client_body_timeout 1800s;
client_header_timeout 1800s;
proxy_connect_timeout 1800s;
proxy_send_timeout 1800s;
proxy_read_timeout 1800s;
send_timeout 1800s;

# Buffer settings
client_body_buffer_size 256k;
proxy_buffering off;
proxy_request_buffering off;

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # ── Security headers ─────────────────────────────────────────────────
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # ── Compression ──────────────────────────────────────────────────────
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # ── API proxy: /api/* -> FastAPI (prefix stripped) ──────────────────
    location /api/ {
        proxy_pass http://${API_UPSTREAM_HOST}:8000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # WebSocket support (analytics + xai streams)
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 1800s;
        proxy_send_timeout 1800s;
        proxy_buffering off;
    }

    # ── Health check ─────────────────────────────────────────────────────
    location = /health {
        access_log off;
        proxy_pass http://${API_UPSTREAM_HOST}:8000/health;
        proxy_set_header Host $host;
    }

    # ── Prometheus metrics source ────────────────────────────────────────
    # nginx's built-in stub_status module. Restricted to 127.0.0.1 because
    # the pulse-nginx-exporter sidecar (see deployment.yaml) reaches it over
    # localhost - containers in the same pod share a network namespace, so
    # this never needs to be reachable from anywhere else.
    location = /stub_status {
        access_log off;
        allow 127.0.0.1;
        deny all;
        stub_status;
    }

    # ── React SPA (client-side routing fallback) ─────────────────────────
    location / {
        try_files $uri $uri/ /index.html;
    }
}
